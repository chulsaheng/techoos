{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file-raw",
    "source": "/usr/share/techoos/logo.txt",
    "position": "top",
    "padding": { "top": 1, "bottom": 1, "left": 1 }
  },
  "display": { "separator": "  " },
  "modules": [
    { "type": "title", "key": "TechoOS" },
    "separator",
    { "type": "os", "key": "OS" },
    { "type": "kernel", "key": "Kernel" },
    { "type": "host", "key": "Host" },
    { "type": "shell", "key": "Shell" },
    { "type": "de", "key": "Desktop" },
    { "type": "terminal", "key": "Terminal" },
    { "type": "cpu", "key": "CPU" },
    { "type": "gpu", "key": "GPU" },
    { "type": "memory", "key": "Memory" },
    "break",
    "colors"
  ]
}
