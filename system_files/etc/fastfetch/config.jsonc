{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file-raw",
    "source": "/usr/share/techoos/logo.txt",
    "width": 60,
    "height": 8,
    "padding": { "top": 1, "left": 2 }
  },
  "display": { "separator": "  " },
  "modules": [
    "break",
    { "type": "title", "key": "  " },
    { "type": "separator", "key": "  " },
    { "type": "os", "key": "  OS      " },
    { "type": "kernel", "key": "  Kernel  " },
    { "type": "host", "key": "  Host    " },
    { "type": "shell", "key": "  Shell   " },
    { "type": "de", "key": "  Desktop " },
    { "type": "terminal", "key": "  Term    " },
    { "type": "cpu", "key": "  CPU     " },
    { "type": "gpu", "key": "  GPU     " },
    { "type": "memory", "key": "  Memory  " },
    "break",
    "colors"
  ]
}
